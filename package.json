{
  "name": "color-conversion",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "fredu",
  "repository": "https://github.com/fred-hu/vscode-color-conversion",
  "version": "0.0.6",
  "keywords": [
    "vscode",
    "plugin",
    "color",
    "color change",
    "color convert",
    "color conversion"
  ],
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "static/colors.png",
  "main": "./extension.js",
  "l10n": "./l10n",
  "volta": {
    "node": "20.18.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "color-conversion.colorConversion",
        "title": "%command.colorConversion.title%",
        "icon": {
          "light": "static/color-conversion-light.png",
          "dark": "static/color-conversion-dark.png"
        }
      },
      {
        "command": "color-conversion.convertToHex",
        "title": "%command.convertToHex.title%"
      },
      {
        "command": "color-conversion.convertToRgb",
        "title": "%command.convertToRgb.title%"
      },
      {
        "command": "color-conversion.convertToRgba",
        "title": "%command.convertToRgba.title%"
      },
      {
        "command": "color-conversion.convertToHsl",
        "title": "%command.convertToHsl.title%"
      },
      {
        "command": "color-conversion.convertToHsla",
        "title": "%command.convertToHsla.title%"
      }
    ],
    "submenus": [
      {
        "id": "color-conversion.submenu",
        "label": "%submenu.colorConversion.label%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorFocus",
          "command": "color-conversion.colorConversion",
          "alt": "",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "colorConversion.hasColor",
          "submenu": "color-conversion.submenu",
          "group": "0_Starling"
        }
      ],
      "color-conversion.submenu": [
        {
          "command": "color-conversion.convertToHex",
          "group": "1_conversion"
        },
        {
          "command": "color-conversion.convertToRgb",
          "group": "1_conversion"
        },
        {
          "command": "color-conversion.convertToRgba",
          "group": "1_conversion"
        },
        {
          "command": "color-conversion.convertToHsl",
          "group": "1_conversion"
        },
        {
          "command": "color-conversion.convertToHsla",
          "group": "1_conversion"
        },
        {
          "command": "color-conversion.colorConversion",
          "group": "2_format"
        }
      ]
    },
    "keybindings": [
      {
        "command": "color-conversion.colorConversion",
        "key": "ctrl+f1",
        "mac": "cmd+f1",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "color-conversion.defaultFormat": {
          "type": "string",
          "enum": [
            "ask",
            "hex",
            "rgb",
            "rgba",
            "hsl",
            "hsla"
          ],
          "enumDescriptions": [
            "%configuration.defaultFormat.ask%",
            "%configuration.defaultFormat.hex%",
            "%configuration.defaultFormat.rgb%",
            "%configuration.defaultFormat.rgba%",
            "%configuration.defaultFormat.hsl%",
            "%configuration.defaultFormat.hsla%"
          ],
          "default": "ask",
          "description": "%configuration.defaultFormat.description%"
        },
        "color-conversion.spacing": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.spacing.description%"
        },
        "color-conversion.hexCase": {
          "type": "string",
          "enum": [
            "lower",
            "upper",
            "preserve"
          ],
          "enumDescriptions": [
            "%configuration.hexCase.lower%",
            "%configuration.hexCase.upper%",
            "%configuration.hexCase.preserve%"
          ],
          "default": "lower",
          "description": "%configuration.hexCase.description%"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "mocha --ui tdd \"test/unit/**/*.test.js\"",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.6.0",
    "glob": "^10.4.2",
    "mocha": "^10.5.2"
  }
}